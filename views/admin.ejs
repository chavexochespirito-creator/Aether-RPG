<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8"><title>SAMP Admin Pro</title>
    <style>
        body { background: #0f0f0f; color: white; font-family: 'Segoe UI', sans-serif; margin: 0; display: flex; }
        .sidebar { width: 260px; background: #111; height: 100vh; padding: 20px; border-right: 3px solid #f1c40f; position: fixed; }
        .main { margin-left: 260px; padding: 40px; width: 100%; }
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 40px; }
        .stat-card { background: #1a1a1a; padding: 25px; border-radius: 20px; border-bottom: 5px solid #f1c40f; box-shadow: 0 5px 15px rgba(0,0,0,0.3); }
        .stat-card h4 { color: #aaa; margin: 0; font-size: 14px; text-transform: uppercase; }
        .stat-card p { font-size: 32px; font-weight: bold; margin: 10px 0 0; color: #f1c40f; }
        table { width: 100%; border-collapse: collapse; background: #1a1a1a; border-radius: 15px; overflow: hidden; }
        th, td { padding: 15px; text-align: left; border-bottom: 1px solid #333; }
        th { background: #f1c40f; color: black; font-weight: bold; }
        .btn-approve { background: #2ecc71; color: white; border: none; padding: 8px 15px; border-radius: 8px; cursor: pointer; font-weight: bold; }
        .search-box { margin-bottom: 20px; display: flex; gap: 10px; }
        .search-box input { padding: 12px; border-radius: 8px; border: none; width: 300px; background: #222; color: white; }
        .search-box button { padding: 12px 20px; background: #f1c40f; border: none; border-radius: 8px; cursor: pointer; font-weight: bold; }
    </style>
</head>
<body>
    <div class="sidebar">
        <h2 style="color: #f1c40f;">SAMP ADMIN</h2>
        <div style="margin-top: 40px; line-height: 3;">
            <div style="color: #f1c40f; font-weight: bold;">📊 Dashboard</div>
            <div>👥 Usuários</div>
            <div>💰 Financeiro</div>
            <div>⚙️ Configurações</div>
        </div>
    </div>
    <div class="main">
        <h1>Painel de Controle Premium</h1>
        <div class="stats-grid">
            <div class="stat-card"><h4>Faturamento Total</h4><p>R$ <%= totalRevenue %></p></div>
            <div class="stat-card"><h4>Jogadores Ativos</h4><p><%= users.length %></p></div>
            <div class="stat-card"><h4>Pedidos Pendentes</h4><p><%= orders.length %></p></div>
        </div>
        <h2>📦 Gestão de Pedidos</h2>
        <table>
            <tr><th>Usuário</th><th>Cash</th><th>Valor</th><th>Status</th><th>Ação</th></tr>
            <% orders.forEach(order => { %>
            <tr>
                <td><%= order.username %></td>
                <td><%= order.cashAmount %></td>
                <td>R$ <%= order.amount %></td>
                <td style="color: <%= order.status === 'Pendente' ? 'orange' : 'green' %>"><%= order.status %></td>
                <td>
                    <% if(order.status === 'Pendente') { %>
                        <form action="/approve" method="POST">
                            <input type="hidden" name="id" value="<%= order._id %>">
                            <button class="btn-approve">Aprovar</button>
                        </form>
                    <% } %>
                </td>
            </tr>
            <% }) %>
        </table>
        <h2 style="margin-top: 50px;">👥 Base de Usuários</h2>
        <form class="search-box" action="/admin" method="GET">
            <input name="search" placeholder="Pesquisar jogador..." value="<%= query %>">
            <button type="submit">Buscar</button>
        </form>
        <table>
            <tr><th>Usuário</th><th>E-mail</th><th>Saldo Cash</th></tr>
            <% users.forEach(user => { %>
            <tr><td><%= user.username %></td><td><%= user.email %></td><td>$<%= user.cash %></td></tr>
            <% }) %>
        </table>
    </div>
</body>
</html>
