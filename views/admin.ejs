<!DOCTYPE html>
<html>
<head>
    <title>Painel ADM - SAMP</title>
    <style>
        body { background: #0f0f0f; color: white; font-family: sans-serif; text-align: center; }
        table { width: 80%; margin: 50px auto; border-collapse: collapse; background: #1a1a1a; }
        th, td { border: 1px solid #f1c40f; padding: 15px; text-align: center; }
        th { background: #f1c40f; color: black; }
        button { background: #2ecc71; color: white; border: none; padding: 8px; cursor: pointer; border-radius: 5px; }
    </style>
</head>
<body>
    <h1>Pedidos de Cash Pendentes</h1>
    <table>
        <tr>
            <th>Usuário</th>
            <th>Quantidade de Cash</th>
            <th>Ação</th>
        </tr>
        <% orders.forEach(order => { %>
        <tr>
            <td><%= order.username %></td>
            <td><%= order.amount %></td>
            <td>
                <form action="/approve" method="POST">
                    <input type="hidden" name="id" value="<%= order._id %>">
                    <button type="submit">Aprovar e Dar Cash</button>
                </form>
            </td>
        </tr>
        <% }) %>
    </table>
</body>
</html>
