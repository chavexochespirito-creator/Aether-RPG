<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aether RPG - Acesso Elite</title>
    <style>
        body { background: radial-gradient(circle at center, #0d1b2a 0%, #050a0f 100%); color: white; font-family: 'Segoe UI', sans-serif; margin: 0; display: flex; justify-content: center; align-items: center; height: 100vh; overflow: hidden; }
        .auth-card { background: #0f172a; width: 400px; padding: 40px; border-radius: 30px; border: 1px solid rgba(0, 162, 255, 0.3); box-shadow: 0 20px 50px rgba(0,0,0,0.8); text-align: center; position: relative; }
        h1 { font-size: 32px; margin-bottom: 10px; }
        h1 span { color: #00a2ff; }
        .subtitle { color: #94a3b8; font-size: 14px; margin-bottom: 30px; line-height: 1.5; }
        .input-group { text-align: left; margin-bottom: 20px; }
        .input-group label { display: block; font-size: 13px; color: #94a3b8; margin-bottom: 8px; margin-left: 5px; }
        .input-group input { width: 100%; padding: 14px; border-radius: 12px; border: 1px solid #1e293b; background: #0f172a; color: white; box-sizing: border-box; transition: 0.3s; }
        .input-group input:focus { outline: none; border-color: #00a2ff; box-shadow: 0 0 10px rgba(0, 162, 255, 0.2); }
        .options { display: flex; justify-content: space-between; align-items: center; font-size: 13px; margin-bottom: 30px; color: #94a3b8; }
        .btn-main { width: 100%; padding: 15px; background: #00a2ff; border: none; border-radius: 12px; color: white; font-weight: bold; font-size: 16px; cursor: pointer; transition: 0.3s; }
        .btn-main:hover { background: #0086d1; transform: translateY(-2px); }
        .footer-text { margin-top: 30px; font-size: 14px; color: #64748b; }
        .footer-text a { color: #00a2ff; text-decoration: none; font-weight: bold; }
        .error-msg { background: rgba(231, 76, 60, 0.2); color: #ff7675; padding: 10px; border-radius: 10px; margin-bottom: 20px; font-size: 14px; border: 1px solid #ff7675; }
        .form-section { display: none; }
        .form-section.active { display: block; }
    </style>
</head>
<body>
    <div class="auth-card">
        <h1>Acesso <span>Elite</span></h1>
        <p class="subtitle">Entre em sua conta para acessar conteúdo exclusivo e vantagens premium</p>
        <% if(error) { %> <div class="error-msg"><%= error %></div> <% } %>
        <div id="login-section" class="form-section active">
            <form action="/login" method="POST">
                <div class="input-group"><label>Usuário</label><input name="username" placeholder="Digite seu usuário" required></div>
                <div class="input-group"><label>Senha</label><input name="password" type="password" placeholder="Sua senha de acesso" required></div>
                <div class="options"><label><input type="checkbox"> Lembrar de mim</label><a href="/terms" style="color:#00a2ff; text-decoration:none;">Esqueceu a senha?</a></div>
                <button type="submit" class="btn-main">Entrar na Elite ➔</button>
            </form>
        </div>
        <div id="reg-section" class="form-section">
            <form action="/register" method="POST">
                <div class="input-group"><label>Nome de Usuário</label><input name="username" placeholder="Escolha um usuário" required></div>
                <div class="input-group"><label>E-mail</label><input name="email" type="email" placeholder="Seu melhor e-mail" required></div>
                <div class="input-group"><label>Senha</label><input name="password" type="password" placeholder="Crie uma senha forte" required></div>
                <button type="submit" class="btn-main">Criar Conta Agora</button>
            </form>
        </div>
        <div class="footer-text">Não tem uma conta? <a href="javascript:void(0)" onclick="toggleAuth()">Criar conta no servidor</a></div>
    </div>
    <script>
        function toggleAuth() {
            document.getElementById('login-section').classList.toggle('active');
            document.getElementById('reg-section').classList.toggle('active');
        }
    </script>
</body>
</html>
