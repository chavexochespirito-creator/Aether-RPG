<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SAMP Portal</title>
    <style>
        body { margin: 0; font-family: 'Segoe UI', sans-serif; background: #f0f2f5; display: flex; height: 100vh; overflow: hidden; }
        .left-side { flex: 1; background: #48c9b0; display: flex; flex-direction: column; justify-content: center; align-items: center; color: white; text-align: center; padding: 40px; }
        .left-side h1 { font-size: 32px; margin-bottom: 20px; }
        .right-side { flex: 1; background: #2c3e50; display: flex; justify-content: center; align-items: center; color: white; }
        .form-container { width: 350px; padding: 20px; }
        .tabs { display: flex; gap: 20px; margin-bottom: 30px; font-size: 20px; cursor: pointer; }
        .tab { opacity: 0.6; transition: 0.3s; }
        .tab.active { opacity: 1; border-bottom: 3px solid #48c9b0; font-weight: bold; }
        .form-section { display: none; }
        .form-section.active { display: block; }
        input { width: 100%; padding: 12px; margin: 10px 0; border-radius: 5px; border: none; background: rgba(255,255,255,0.1); color: white; box-sizing: border-box; border-bottom: 2px solid #48c9b0; }
        button { width: 100%; padding: 12px; background: #48c9b0; border: none; border-radius: 25px; font-weight: bold; cursor: pointer; margin-top: 20px; color: #2c3e50; }
        .error-msg { background: rgba(231, 76, 60, 0.2); color: #ff7675; padding: 10px; border-radius: 5px; margin-bottom: 15px; text-align: center; border: 1px solid #ff7675; }
    </style>
</head>
<body>
    <div class="left-side">
        <h1>SAMP SERVER</h1>
        <p>Planeje suas atividades e controle seu progresso online!</p>
        <img src="https://cdn-icons-png.flaticon.com/512/1356/1356479.png" width="200">
    </div>
    <div class="right-side">
        <div class="form-container">
            <% if(error) { %> <div class="error-msg"><%= error %></div> <% } %>
            <div class="tabs">
                <div class="tab active" onclick="openTab('login')">Sign In</div>
                <div class="tab" onclick="openTab('reg')">Sign Up</div>
            </div>
            <div id="login" class="form-section active">
                <form action="/login" method="POST">
                    <label>USUÁRIO</label><input name="username" required>
                    <label>SENHA</label><input name="password" type="password" required>
                    <button type="submit">ENTRAR</button>
                </form>
            </div>
            <div id="reg" class="form-section">
                <form action="/register" method="POST">
                    <label>NOME COMPLETO</label><input name="username" required>
                    <label>E-MAIL</label><input name="email" type="email" required>
                    <label>SENHA</label><input name="password" type="password" required>
                    <button type="submit">CADASTRAR</button>
                </form>
            </div>
        </div>
    </div>
    <script>
        function openTab(tabId) {
            document.querySelectorAll('.form-section').forEach(s => s.classList.remove('active'));
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            event.currentTarget.classList.add('active');
        }
    </script>
</body>
</html>
