<!DOCTYPE html>
<html>
<head>
    <title>Loja SAMP</title>
    <style>
        body { background: #0f0f0f; color: white; font-family: sans-serif; text-align: center; }
        .header { background: #1a1a1a; padding: 20px; border-bottom: 3px solid #f1c40f; }
        .container { display: flex; justify-content: center; gap: 20px; margin-top: 50px; flex-wrap: wrap; }
        .card { background: #1a1a1a; padding: 20px; border-radius: 10px; border: 1px solid #f1c40f; width: 200px; }
        button { background: #f1c40f; padding: 10px; border: none; cursor: pointer; border-radius: 5px; font-weight: bold; width: 100%; }
        .pix { color: #f1c40f; font-weight: bold; margin: 20px; font-size: 1.2em; }
    </style>
</head>
<body>
    <div class="header">
        <h1>Bem-vindo, <%= user.username %>!</h1>
        <p>Seu Saldo Atual: <b style="color: #f1c40f;">$<%= user.cash %></b></p>
        <a href="/logout" style="color: red;">Sair da Conta</a>
    </div>

    <div class="pix">🔑 CHAVE PIX PARA PAGAMENTO: (COLOQUE SEU PIX AQUI)</div>

    <div class="container">
        <div class="card">
            <h3>1.000 Cash</h3>
            <p>Valor: R$ 10,00</p>
            <form action="/buy" method="POST">
                <input type="hidden" name="amount" value="1000">
                <button type="submit">COMPRAR</button>
            </form>
        </div>
        <div class="card">
            <h3>5.000 Cash</h3>
            <p>Valor: R$ 40,00</p>
            <form action="/buy" method="POST">
                <input type="hidden" name="amount" value="5000">
                <button type="submit">COMPRAR</button>
            </form>
        </div>
    </div>
</body>
</html>
