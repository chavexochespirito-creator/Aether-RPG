<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8"><title>Loja Premium - SAMP</title>
    <style>
        body { background: #0a0a0a; color: white; font-family: 'Segoe UI', sans-serif; margin: 0; }
        nav { background: #111; padding: 20px 50px; display: flex; justify-content: space-between; border-bottom: 3px solid #f1c40f; }
        .shop-container { display: flex; flex-direction: column; align-items: center; padding: 50px; }
        .packages-grid { display: flex; gap: 30px; justify-content: center; margin-bottom: 50px; flex-wrap: wrap; }
        .package-card { background: #1a1a1a; width: 220px; padding: 20px; border-radius: 20px; border: 1px solid #333; text-align: center; transition: 0.3s; cursor: pointer; }
        .package-card:hover { border-color: #f1c40f; transform: scale(1.05); }
        .package-card img { width: 100px; height: 100px; margin-bottom: 15px; }
        .package-card h3 { color: #f1c40f; margin: 10px 0; }
        .cash-selector { background: #1a1a1a; padding: 40px; border-radius: 30px; border: 2px solid #f1c40f; text-align: center; box-shadow: 0 0 20px rgba(241,196,15,0.2); }
        .counter { display: flex; justify-content: center; align-items: center; gap: 30px; margin: 20px 0; }
        .btn-count { background: #f1c40f; border: none; width: 60px; height: 60px; border-radius: 50%; font-size: 30px; font-weight: bold; cursor: pointer; }
        #cash-value { font-size: 50px; font-weight: bold; min-width: 200px; }
        .price-tag { font-size: 24px; color: #aaa; margin-bottom: 20px; }
        .btn-buy { width: 250px; padding: 15px; background: #f1c40f; border: none; border-radius: 15px; font-weight: bold; cursor: pointer; font-size: 20px; }
    </style>
</head>
<body>
    <nav>
        <div style="color: #f1c40f; font-weight: bold; font-size: 22px;">SAMP PREMIUM</div>
        <div>Olá, <%= user.username %> | <b style="color: #f1c40f;">$<%= user.cash %></b> | <a href="/logout" style="color: red; text-decoration: none; margin-left: 20px;">Sair</a></div>
    </nav>
    <div class="shop-container">
        <h1>Escolha seu Pacote de Cash</h1>
        <div class="packages-grid">
            <div class="package-card" onclick="setCash(1000)">
                <img src="https://cdn-icons-png.flaticon.com/512/2489/2489756.png">
                <h3>Iniciante</h3><p>1.000 Moedas</p><p><b>R$ 1,00</b></p>
            </div>
            <div class="package-card" onclick="setCash(5000)">
                <img src="https://cdn-icons-png.flaticon.com/512/2489/2489761.png">
                <h3>Intermediário</h3><p>5.000 Moedas</p><p><b>R$ 5,00</b></p>
            </div>
            <div class="package-card" onclick="setCash(10000)">
                <img src="https://cdn-icons-png.flaticon.com/512/2489/2489765.png">
                <h3>Magnata</h3><p>10.000 Moedas</p><p><b>R$ 10,00</b></p>
            </div>
        </div>
        <div class="cash-selector">
            <h2>Personalizar Quantia</h2>
            <div class="counter">
                <button class="btn-count" onclick="changeCash(-100)">-</button>
                <div id="cash-value">1000</div>
                <button class="btn-count" onclick="changeCash(100)">+</button>
            </div>
            <div class="price-tag">Valor Total: R$ <span id="price">1.00</span></div>
            <form action="/create-payment" method="POST">
                <input type="hidden" name="cashAmount" id="input-cash" value="1000">
                <button class="btn-buy" type="submit">CONFIRMAR COMPRA</button>
            </form>
        </div>
    </div>
    <script>
        let cash = 1000;
        function setCash(val) { cash = val; update(); }
        function changeCash(val) { cash += val; if(cash < 100) cash = 100; update(); }
        function update() {
            document.getElementById('cash-value').innerText = cash;
            document.getElementById('input-cash').value = cash;
            document.getElementById('price').innerText = (cash / 1000).toFixed(2);
        }
    </script>
</body>
</html>
