<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8"><title>Aether RPG - Loading</title>
    <style>
        body { background: #050a0f; color: white; font-family: 'Segoe UI', sans-serif; margin: 0; display: flex; justify-content: center; align-items: center; height: 100vh; overflow: hidden; }
        .loader-container { text-align: center; width: 300px; }
        .logo { font-size: 42px; font-weight: 800; letter-spacing: 2px; margin-bottom: 20px; }
        .logo span { color: #00a2ff; }
        .progress-bar { width: 100%; height: 4px; background: #1a2a3a; border-radius: 10px; position: relative; overflow: hidden; }
        .progress-fill { width: 0%; height: 100%; background: #00a2ff; position: absolute; left: 0; top: 0; transition: width 0.1s linear; box-shadow: 0 0 10px #00a2ff; }
        .loading-text { margin-top: 15px; font-size: 14px; color: #667; font-style: italic; }
    </style>
</head>
<body>
    <div class="loader-container">
        <div class="logo">AETHER<span>RPG</span></div>
        <div class="progress-bar"><div class="progress-fill" id="fill"></div></div>
        <div class="loading-text">Carregando experiência premium...</div>
    </div>
    <script>
        let width = 0;
        const fill = document.getElementById('fill');
        const interval = setInterval(() => {
            if (width >= 100) { clearInterval(interval); setTimeout(() => { window.location.href = '/auth'; }, 500); } 
            else { width += Math.random() * 5; if(width > 100) width = 100; fill.style.width = width + '%'; }
        }, 100);
    </script>
</body>
</html>
